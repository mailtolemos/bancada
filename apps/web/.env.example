# ── Fornecedor primário: football-data.org (GRÁTIS) ─────────────────
# Regista-te em https://www.football-data.org/client/register e cola aqui o token.
# Free tier: Liga Portugal, resultados, calendário, classificação, marcadores.
FOOTBALL_DATA_API_KEY=

# ── Fornecedor avançado: API-Football (opcional, a partir de ~$29/mês) ─
# https://www.api-football.com — desbloqueia 11 inicial, eventos ao minuto,
# ratings de jogadores e estatísticas de jogo. Sem chave, a app funciona
# na mesma com o fornecedor primário.
API_FOOTBALL_KEY=

# Forçar modo demo mesmo com chaves definidas (útil para desenvolvimento)
# BANCADA_DEMO=1
